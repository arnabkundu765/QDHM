@{
    Layout = null;
}
@*
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QNDHM Partner CRM Summary</title>
    <script src="~/js/dashboard.js"></script>
</head>
<body>
    <div class="layout">
        <aside class="sidebar">
            <div class="brand">
                <div class="logo">QA</div>
                <div><b>Ministry of Public Health</b><small>State of Qatar<br>QNDHM</small></div>
            </div>
            <div class="nav-title">CRM workspace</div><a class="nav active" href="#">▦ Summary Dashboard</a><a class="nav" href="/auth/registration">＋ New Registration</a><a class="nav" href="#">
            ♙
            Partners
        </a><a class="nav" href="#">◫ Onboarding Pipeline</a><a class="nav" href="#">
        ◷ Support
        Tickets
    </a><a class="nav" href="#">✓ Compliance</a><a class="nav" href="#">⇄ Integrations</a><a class="nav" href="#">▤ Reports</a>
    <div class="mission"><b>QNDHM</b><br><small>One Nation<br>One Health Network<br>Connected Care</small></div>
</aside>
<main class="main">
    <header class="topbar">
        <div>
            <h1>QATAR NATIONAL DIGITAL HEALTH MISSION (QNDHM)</h1>
            <p>Partner CRM Summary &amp; Registration Management</p>
        </div>
        <div class="user">
            <div class="avatar">JD</div>
            <div><b>John Doe</b><small>CRM Admin</small></div>
        </div>
    </header>
    <div class="page">
        <div class="welcome">
            <div>
                <h2>Partner Registration Summary</h2>
                <p>View, search, preview and update all organization onboarding records.</p>
            </div><button class="btn primary" onclick="location.href='/auth/registration'">
            ＋ New
            Registration
        </button>
    </div>
    <section class="kpis">
        <div class="kpi">
            <div class="kpi-top">
                <div class="kpi-icon">▥</div><span class="mini-trend">↑ 12.5%</span>
            </div><b id="totalKpi">12</b><span>Total Applications</span>
        </div>
        <div class="kpi">
            <div class="kpi-top">
                <div class="kpi-icon">◷</div><span class="mini-trend">Current</span>
            </div><b id="draftKpi">3</b><span>Draft Applications</span>
        </div>
        <div class="kpi">
            <div class="kpi-top">
                <div class="kpi-icon">⌘</div><span class="mini-trend">Active</span>
            </div><b id="progressKpi">4</b><span>In Assessment</span>
        </div>
        <div class="kpi">
            <div class="kpi-top">
                <div class="kpi-icon">✓</div><span class="mini-trend">This month</span>
            </div><b id="certKpi">3</b><span>Certified Partners</span>
        </div>
        <div class="kpi">
            <div class="kpi-top">
                <div class="kpi-icon">⇄</div><span class="mini-trend">Live</span>
            </div><b id="prodKpi">2</b><span>Production Live</span>
        </div>
        <div class="kpi">
            <div class="kpi-top">
                <div class="kpi-icon">▣</div><span class="mini-trend">Needs action</span>
            </div><b>7</b><span>Open Support Tickets</span>
        </div>
    </section>
    <section class="panel">
        <div class="panel-head">
            <div>
                <h3>Saved Registration Entries</h3>
                <p>Click a registration ID to open the complete record.</p>
            </div>
            <div><button class="btn outline" onclick="exportCSV()">⇩ Export CSV</button></div>
        </div>
        <div class="filters">
            <input id="search" class="control"
                   placeholder="Search ID, organization, SPOC, product..." oninput="render()"><select id="typeFilter" class="control" onchange="render()">
            <option value="">All entity types</option>
            <option>Digital Solution Company</option>
            <option>Hospital</option>
            <option>Clinic</option>
            <option>Laboratory</option>
            <option>Pharmacy</option>
        </select><select id="stageFilter" class="control" onchange="render()">
        <option value="">All stages</option>
        <option>Draft</option>
        <option>Sandbox</option>
        <option>Compliance</option>
        <option>Security</option>
        <option>Certified</option>
        <option>Production</option>
    </select><select id="statusFilter" class="control" onchange="render()">
    <option value="">All statuses</option>
    <option>Draft</option>
    <option>Under Review</option>
    <option>Observation Open</option>
    <option>Approved</option>
    <option>Live</option>
</select><select id="riskFilter" class="control" onchange="render()">
<option value="">All risks</option>
<option>Low</option>
<option>Medium</option>
<option>High</option>
</select><button class="btn light" onclick="resetFilters()">Reset</button>
</div>
<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Registration ID</th>
                <th>Organization</th>
                <th>Entity Type</th>
                <th>Primary SPOC</th>
                <th>Product</th>
                <th>Current Stage</th>
                <th>Progress</th>
                <th>Open Tickets</th>
                <th>Target Go-Live</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="rows"></tbody>
    </table>
</div>
<div id="empty" class="empty">No matching applications found.</div>
<div class="table-footer">
    <span id="recordCount"></span>
    <div class="pages">
        <button class="active">
            1
        </button><button>2</button><button>3</button><button>›</button>
    </div>
</div>
</section>
</div>
</main>
</div>

<div id="overlay" class="overlay" onclick="backdropClose(event)">
    <section class="drawer">
        <div class="drawer-head">
            <div>
                <h2 id="drawerTitle">Partner Record</h2>
                <p id="drawerSub"></p>
            </div>
            <div class="drawer-actions">
                <button id="editTop" class="btn outline" onclick="toggleEdit()">
                    ✎
                    Edit
                </button><button class="close" onclick="closeDrawer()">×</button>
            </div>
        </div>
        <div class="tabs">
            <button class="tab-btn active" data-tab="overview">Profile</button><button class="tab-btn"
                                                                                   data-tab="organization">
            Organization
        </button><button class="tab-btn"
                     data-tab="contacts">
        Contacts
    </button><button class="tab-btn" data-tab="integration">
    Product &amp;
    Integration
</button><button class="tab-btn" data-tab="timeline">Timeline</button><button class="tab-btn" data-tab="assessment">
Assessments
</button><button class="tab-btn"
             data-tab="tickets">
Support Tickets
</button>
</div>
<div class="drawer-body">
    <div id="overview" class="tab-content active">
        <div class="card">
            <h3>Profile Details</h3>
            <div class="detail-grid">
                <div class="field"><label>Registration ID</label><input data-key="id" disabled></div>
                <div class="field"><label>Application Status</label><input data-key="status" disabled></div>
                <div class="field">
                    <label>Portal Username</label><input value="meditech.admin" disabled>
                </div>
                <div class="field">
                    <label>Official Email</label><input value="admin@meditech.qa" disabled>
                </div>
                <div class="field"><label>Application Owner</label><input data-key="spoc" disabled></div>
                <div class="field"><label>Risk</label><input data-key="risk" disabled></div>
            </div>
        </div>
    </div>
    <div id="organization" class="tab-content">
        <div class="card">
            <h3>Organization Details</h3>
            <div class="detail-grid">
                <div class="field"><label>Organization Name</label><input data-key="org" disabled></div>
                <div class="field"><label>Entity Type</label><input data-key="type" disabled></div>
                <div class="field">
                    <label>Commercial Registration No.</label><input value="CRN-1234567890"
                                                                     disabled>
                </div>
                <div class="field">
                    <label>Ministry License No.</label><input value="ML-987654321" disabled>
                </div>
                <div class="field">
                    <label>Website</label><input value="https://www.meditech.qa" disabled>
                </div>
                <div class="field"><label>Municipality</label><input value="West Bay" disabled></div>
                <div class="field full">
                    <label>Registered Address</label><textarea disabled>Al Muntazah, West Bay, Doha, State of Qatar</textarea>
                </div>
            </div>
        </div>
    </div>
    <div id="contacts" class="tab-content">
        <div class="card">
            <h3>Contacts &amp; SPOCs</h3>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Role</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Mobile</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Primary Contact</td>
                            <td data-text="spoc"></td>
                            <td>primary@partner.qa</td>
                            <td>+974 5012 3456</td>
                        </tr>
                        <tr>
                            <td>Technical SPOC</td>
                            <td>Sara Khan</td>
                            <td>technical@partner.qa</td>
                            <td>+974 5588 7766</td>
                        </tr>
                        <tr>
                            <td>Compliance SPOC</td>
                            <td>Mohammed Ali</td>
                            <td>compliance@partner.qa</td>
                            <td>+974 6677 8899</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div id="integration" class="tab-content">
        <div class="card">
            <h3>Product &amp; Integration Details</h3>
            <div class="detail-grid">
                <div class="field"><label>Product Name</label><input data-key="product" disabled></div>
                <div class="field">
                    <label>Solution Type</label><input value="API Based Solution" disabled>
                </div>
                <div class="field">
                    <label>Integration Type</label><input value="Provider - Provider"
                                                          disabled>
                </div>
                <div class="field">
                    <label>Requested APIs</label><input value="Q-HPR, Q-HFR, Q-HIE, Consent"
                                                        disabled>
                </div>
                <div class="field full">
                    <label>Description</label><textarea disabled>Interoperability solution for secure healthcare data exchange using QNDHM standards and APIs.</textarea>
                </div>
            </div>
        </div>
    </div>
    <div id="timeline" class="tab-content">
        <div class="card">
            <h3>Onboarding Journey</h3>
            <div class="timeline">
                <div class="stage done">
                    <div class="dot">✓</div><b>Registration</b><small>Complete</small>
                </div>
                <div class="stage done">
                    <div class="dot">✓</div><b>Sandbox</b><small>Complete</small>
                </div>
                <div class="stage current">
                    <div class="dot"></div><b>Compliance</b><small>Current</small>
                </div>
                <div class="stage">
                    <div class="dot"></div><b>Security</b><small>Pending</small>
                </div>
                <div class="stage">
                    <div class="dot"></div><b>Certification</b><small>Pending</small>
                </div>
                <div class="stage">
                    <div class="dot"></div><b>Production</b><small>Pending</small>
                </div>
            </div>
            <div class="detail-grid">
                <div class="field"><label>Current Stage</label><input data-key="stage" disabled></div>
                <div class="field"><label>Progress</label><input data-key="progressText" disabled></div>
                <div class="field"><label>Target Go-Live</label><input data-key="goLive" disabled></div>
                <div class="field"><label>Last Updated</label><input data-key="updated" disabled></div>
            </div>
        </div>
    </div>
    <div id="assessment" class="tab-content">
        <div class="card">
            <h3>Compliance &amp; Security Assessments</h3>
            <div class="detail-grid">
                <div class="field">
                    <label>Compliance Status</label><input value="Observation Open" disabled>
                </div>
                <div class="field"><label>Risk Rating</label><input data-key="risk" disabled></div>
                <div class="field"><label>Security Status</label><input value="In Progress" disabled></div>
                <div class="field">
                    <label>VAPT Findings</label><input value="2 Medium, 1 Low" disabled>
                </div>
                <div class="field full">
                    <label>Findings Summary</label><textarea disabled>Minor observations related to API error handling, validation and security configuration.</textarea>
                </div>
            </div>
        </div>
    </div>
    <div id="tickets" class="tab-content">
        <div class="card">
            <h3>Support Ticket History</h3>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Ticket ID</th>
                            <th>Subject</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Assigned To</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>QNDHM-TKT-0112</td>
                            <td>Sandbox API authentication</td>
                            <td><span class="pill red">High</span></td>
                            <td><span class="pill red">Open</span></td>
                            <td>API Support</td>
                        </tr>
                        <tr>
                            <td>QNDHM-TKT-0098</td>
                            <td>Additional API package</td>
                            <td><span class="pill amber">Medium</span></td>
                            <td><span class="pill green">Closed</span></td>
                            <td>Integration Team</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="drawer-foot">
    <span class="mode" id="modeText">Preview mode: fields are read-only</span>
    <div>
        <button class="btn light" onclick="closeDrawer()">Close</button> 
        <button id="saveBtn" class="btn primary" style="display:none" onclick="saveRecord()"> Save Changes </button>
    </div>
</div>
</section>
</div>
<div id="toast" class="toast"></div>
</body>
</html>
