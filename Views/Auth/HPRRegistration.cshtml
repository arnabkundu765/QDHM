@{
    Layout = null;
}
<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Healthcare Professional Registration</title>
    <link href="~/css/hpr.css" rel="stylesheet" />
</head>
<body>
    <div class="app">
        <aside class="sidebar"><div class="brand"><div class="logo">QA</div><div><b>Ministry of Public Health</b><small>State of Qatar<br>QNDHM</small></div></div><div class="label">Registration Workspace</div><button class="nav active" id="navRegistration" onclick="showView('registration')">▤ Professional Registration</button><button class="nav" id="navSupport" onclick="showView('support')">◷ Support & Tickets <span class="badge">3</span></button><button class="nav" onclick="location.href='/home/dashboard'">▦ Summary Dashboard</button><button class="nav" data-admin-only onclick="alert('Role and permission management')">⚙ Role Management</button><div class="rolebox"><label>Demo access role</label><select id="role" onchange="applyRole()"><option value="registrant">Registrant</option><option value="support">Support Agent</option><option value="reviewer">Reviewer</option><option value="admin">Administrator</option></select></div></aside><main class="main">
        <header class="top"><div><h1>QATAR NATIONAL DIGITAL HEALTH MISSION (QNDHM)</h1><p>Healthcare Professional Registration</p></div>
            <div class="user">
                <div class="avatar">JD</div>
                <div><b>John Doe</b><br /><small>@(ViewBag.Show ? "Health Professional": "Support Operator")</small></div>
            </div>
            </header><div class="page">
        <section id="registrationView" class="view active"><section class="kpis"><div class="kpi"><div class="ki">♙</div><div><b>10,500+</b><span>Professionals</span></div></div><div class="kpi"><div class="ki">✓</div><div><b>9,860</b><span>Verified</span></div></div><div class="kpi"><div class="ki">🏥</div><div><b>6,400</b><span>Facility Linked</span></div></div><div class="kpi"><div class="ki">◷</div><div><b>218</b><span>Pending</span></div></div></section><div class="work"><aside class="steps"><div class="progress">Registration Progress<div class="track"><div id="bar" class="bar"></div></div></div><button class="step active" onclick="showStep(0)"><span class="num">1</span>Professional Profile</button><button class="step" onclick="showStep(1)"><span class="num">2</span>Identity & Contact</button><button class="step" onclick="showStep(2)"><span class="num">3</span>Professional License</button><button class="step" onclick="showStep(3)"><span class="num">4</span>Qualifications</button><button class="step" onclick="showStep(4)"><span class="num">5</span>Employment & Practice</button><button class="step" onclick="showStep(5)"><span class="num">6</span>Digital Identity & Consent</button><button class="step" onclick="showStep(6)"><span class="num">7</span>Documents</button><button class="step" onclick="showStep(7)"><span class="num">8</span>Review & Submit</button></aside><section class="content"><div class="head"><div><h2 id="stepTitle">Professional Profile</h2><p>Complete the applicable details and continue.</p></div><div style="margin-top: 10px"><span class="chip">Draft</span></div></div><div id="t0" class="tab active"><div class="section"><h3>Profile</h3><div class="grid"><div class="" data-role-field=""><label>Professional ID</label><input type="text" value="QNDHM-HCP-2026-01852"></div><div class="" data-role-field=""><label>Full Name</label><input type="text" value="Dr. Amal Hassan"></div><div class="" data-role-field=""><label>Category</label><select><option>Physician</option><option>Dentist</option><option>Nurse</option><option>Pharmacist</option><option>Allied Health</option></select></div><div class="" data-role-field=""><label>Specialty</label><input type="text" value="Internal Medicine"></div></div></div></div><div id="t1" class="tab"><div class="section"><h3>Identity</h3><div class="grid"><div class="" data-role-field=""><label>Qatar ID / Passport</label><input type="text" value="***********"></div><div class="" data-role-field=""><label>Date of Birth</label><input type="date" value=""></div><div class="" data-role-field=""><label>Email</label><input type="email" value="amal.hassan@provider.qa"></div><div class="" data-role-field=""><label>Mobile</label><input type="text" value="+974 5511 2233"></div><div class="full" data-role-field=""><label>Address</label><textarea>Doha, Qatar</textarea></div></div></div></div><div id="t2" class="tab"><div class="section"><h3>License</h3><div class="grid"><div class="" data-role-field=""><label>Licensing Authority</label><input type="text" value="Department of Healthcare Professions"></div><div class="" data-role-field=""><label>License No.</label><input type="text" value="DHP-MD-56782"></div><div class="" data-role-field=""><label>Status</label><select><option>Active</option><option>Suspended</option><option>Expired</option><option>Under Review</option></select></div><div class="" data-role-field=""><label>Expiry Date</label><input type="date" value=""></div></div></div></div><div id="t3" class="tab"><div class="section"><h3>Qualifications</h3><div class="grid"><div class="" data-role-field=""><label>Highest Qualification</label><input type="text" value="MD"></div><div class="" data-role-field=""><label>Specialization</label><input type="text" value="Internal Medicine"></div><div class="" data-role-field=""><label>Institution</label><input type="text" value="Qatar University"></div><div class="" data-role-field=""><label>Completion Year</label><input type="number" value="2015"></div></div></div></div><div id="t4" class="tab"><div class="section"><h3>Practice</h3><div class="grid"><div class="" data-role-field=""><label>Primary Facility</label><input type="text" value="Doha Care Hospital"></div><div class="" data-role-field=""><label>Facility ID</label><input type="text" value="QNDHM-FAC-2026-00081"></div><div class="" data-role-field=""><label>Department</label><input type="text" value="Internal Medicine"></div><div class="" data-role-field=""><label>Designation</label><input type="text" value="Consultant"></div><div class="" data-role-field=""><label>Employment Type</label><select><option>Full-time</option><option>Part-time</option><option>Visiting</option></select></div></div></div></div><div id="t5" class="tab"><div class="section"><h3>Digital Access</h3><div class="grid"><div class="" data-role-field=""><label>Digital ID Status</label><select><option>Issued</option><option>Not Issued</option><option>Suspended</option></select></div><div class="" data-role-field=""><label>MFA Method</label><select><option>Qatar Digital ID</option><option>Authenticator</option><option>SMS OTP</option></select></div><div class="" data-role-field=""><label>Access Level</label><select><option>Standard</option><option>Specialist</option><option>Emergency</option></select></div><div class="" data-role-field=""><label>Digital Signature</label><select><option>Yes</option><option>No</option></select></div></div></div></div><div id="t6" class="tab"><div class="section"><h3>Required Documents</h3>
            <div class="upload">
                    <div class="upload-field">
                        <label for="Identity">Identity</label>
                        <input type="file" id="Identity" name="Identity"
                               accept=".pdf,.jpg,.jpeg,.png">
                        <a href="#" id="IdentityLink"
                           target="_blank"
                           title="View uploaded Identity Document">👁</a>
                    </div>

                    <div class="upload-field">
                        <label for="Professional">Professional License</label>
                        <input type="file" id="Professional" name="Professional"
                               accept=".pdf,.jpg,.jpeg,.png">
                        <a href="#" id="ProfessionalLink"
                           target="_blank"
                           title="View uploaded Professional License">👁</a>
                    </div>

                    <div class="upload-field">
                        <label for="Degree">Degree</label>
                        <input type="file" id="Degree" name="Degree"
                               accept=".pdf,.jpg,.jpeg,.png">
                        <a href="#" id="DegreeLink"
                           target="_blank"
                           title="View uploaded Degree">👁</a>
                    </div>

                    <div class="upload-field">
                        <label for="Experience">Experience</label>
                        <input type="file" id="Experience" name="Experience"
                               accept=".pdf,.jpg,.jpeg,.png">
                        <a href="#" id="ExperienceLink"
                           target="_blank"
                           title="View uploaded Experience">👁</a>
                    </div>

                    <div class="upload-field">
                        <label for="Photograph">Photograph</label>
                        <input type="file" id="Photograph" name="Photograph"
                               accept=".pdf,.jpg,.jpeg,.png">
                        <a href="#" id="PhotographLink"
                           target="_blank"
                           title="View uploaded Photograph">👁</a>
                    </div>

                    <div class="upload-field">
                        <label for="Authorization">Authorization Documents</label>
                        <input type="file" id="Authorization" name="Authorization"
                               accept=".pdf,.jpg,.jpeg,.png">
                        <a href="#" id="AuthorizationLink"
                           target="_blank"
                           title="View uploaded Authorization Documents">👁</a>
                    </div>
            </div>
            </div></div><div id="t7" class="tab"><div class="section"><h3>Review</h3>Professional registration is ready for review and submission.</div></div></section></div></section><section id="supportView" class="view">
        <div class="notice">Create a new support ticket and track its complete status, assignment, SLA and activity timeline.</div><div class="ticket-tabs"><button id="ttTrack" class="ticket-tab active" onclick="showTicketSection('track')">Track Tickets</button><button id="ttNew" class="ticket-tab" onclick="showTicketSection('new')">Generate New Ticket</button></div><div id="ticketTrackSection" class="support-grid"><div><div class="panel"><div class="panel-head"><div><h2>Support & Ticket Management</h2><small id="supportScope">All tickets visible for current role</small></div><button class="btn primary" onclick="newTicket()">+ Create Ticket</button></div><div class="filters"><input id="ticketSearch" placeholder="Search ticket ID, subject or registration ID" oninput="filterTickets()"><select id="ticketStatus" onchange="filterTickets()"><option value="">All Statuses</option><option>Open</option><option>In Progress</option><option>Awaiting User</option><option>Resolved</option><option>Closed</option></select><select id="ticketPriority" onchange="filterTickets()"><option value="">All Priorities</option><option>Low</option><option>Medium</option><option>High</option><option>Critical</option></select><select id="ticketCategory" onchange="filterTickets()"><option value="">All Categories</option><option>Registration</option><option>Documents</option><option>Integration</option><option>Compliance</option><option>Security</option><option>Production</option></select><button class="btn light" onclick="resetTickets()">Reset</button></div><div class="tablewrap"><table><thead><tr><th>Ticket ID</th><th>Registration ID</th><th>Subject</th><th>Category</th><th>Priority</th><th>Status</th><th>Assigned To</th><th>SLA</th><th>Action</th></tr></thead><tbody id="ticketRows"></tbody></table></div></div></div> <aside style="display:none;"><div class="section"><h3>Add / Update Ticket</h3><div class="grid"><div><label>Registration ID</label><input id="fReg" value="REG-2026-00125"></div><div><label>Ticket ID</label><input id="fTicket" value="QNDHM-TKT-2026-0112"></div><div class="full"><label>Subject</label><input id="fSubject" value="Sandbox authentication support"></div><div><label>Category</label><select id="fCategory"><option>Registration</option><option>Documents</option><option>Integration</option><option>Compliance</option><option>Security</option><option>Production</option></select></div><div><label>Priority</label><select id="fPriority"><option>Low</option><option>Medium</option><option selected>High</option><option>Critical</option></select></div><div data-role-field="agent"><label>Status</label><select id="fStatus"><option>Open</option><option>In Progress</option><option>Awaiting User</option><option>Resolved</option><option>Closed</option></select></div><div data-role-field="agent"><label>Assigned Agent</label><input id="fAgent" value="Integration Support"></div><div class="full"><label>Interaction Summary</label><textarea id="fSummary">Describe issue, response, action item and next step.</textarea></div></div><div class="support-actions"><button class="btn primary" onclick="saveTicket()">Save Ticket</button></div></div><div class="section"><h3>Role Permissions</h3><div id="permissions"></div></div></aside> </div>
        <div id="ticketNewSection" class="section hidden" style="margin:18px"><h3>Generate New Support Ticket</h3><div class="grid three"><div><label>Registration Type</label><select id="nType"><option>Healthcare Facility</option><option>Healthcare Professional</option><option>DSC / Integrator</option></select></div><div><label>Registration ID *</label><input id="nReg" placeholder="Enter registration ID"></div><div><label>Auto-Generated Ticket ID</label><input id="nTicket" readonly></div><div class="full"><label>Ticket Subject *</label><input id="nSubject" placeholder="Enter a clear issue title"></div><div><label>Issue Category *</label><select id="nCategory"><option>Registration</option><option>Profile Update</option><option>Document Verification</option><option>Sandbox / API</option><option>Integration</option><option>Compliance</option><option>Security</option><option>Production</option></select></div><div><label>Priority</label><select id="nPriority"><option>Low</option><option selected>Medium</option><option>High</option><option>Critical</option></select></div><div><label>Raised By</label><input id="nRaisedBy" value="Current Portal User"></div><div><label>Contact Email</label><input id="nEmail" type="email" placeholder="name@organization.qa"></div><div><label>Contact Mobile</label><input id="nMobile" placeholder="+974"></div><div class="full"><label>Issue Description *</label><textarea id="nDescription" placeholder="Describe the issue, steps performed, error message and expected result"></textarea></div><div class="full"><label>Attachment / Log Reference</label><input id="nAttachment" placeholder="Screenshot, log, document or secure file reference"></div></div><div class="support-actions"><button class="btn light" onclick="clearNewTicket()">Clear</button><button class="btn primary" onclick="generateTicket()">Generate Ticket</button></div></div>
        <div id="ticketTimelineSection" class="section hidden" style="margin:18px"><div class="panel-head" style="padding:0 0 14px;border:0"><div><h2 id="timelineTitle">Ticket Tracking</h2><small id="timelineSub"></small></div><button class="btn light" onclick="showTicketSection('track')">Back to Tickets</button></div><div class="grid three"><div><label>Current Status</label><input id="trackStatus" readonly></div><div><label>Assigned Team</label><input id="trackAgent" readonly></div><div><label>SLA</label><input id="trackSla" readonly></div></div><div class="timeline-box" id="timelineBox"></div><div class="section"><h3>Add Comment</h3><textarea id="trackComment" placeholder="Add update, response or additional information"></textarea><div class="support-actions"><button class="btn primary" onclick="addTrackingComment()">Add Comment</button></div></div></div>
    </section>
</div>
</main>
</div>
<div id="formFooter" class="footer"><small id="saved">Draft not saved</small><div><button class="btn outline" onclick="saveDraft()">Save Draft</button><button class="btn light" onclick="move(-1)">Previous</button><button class="btn primary" onclick="move(1)">Save & Continue</button></div></div>
<script src="~/js/hpr.js"></script>
</body>
</html>