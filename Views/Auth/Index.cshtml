@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Qatar National Digital Health Mission</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/izitoast/dist/css/iziToast.min.css">
    <link href="~/css/Landing1.css" rel="stylesheet" />
    <script src="~/js/landing.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/izitoast/dist/js/iziToast.min.js"></script>
</head>
<body>

    <div class="main-container">
        <!-- ==========HEADER==============-->

        <header class="header">
            <!-- LEFT LOGO -->

            <div class="logo">
                <img src="~/asset/moph_logo_25.png" alt="Qatar Ministry of Public Health" />
            </div>
            
            <!-- TITLE -->

            <div class="title-section">

                <h1>
                    QATAR NATIONAL DIGITAL HEALTH MISSION
                </h1>

                <p>
                    Building a Connected, Interoperable &amp;
                    Citizen-Centric Healthcare Ecosystem for Qatar
                </p>

                <div class="tagline">
                    One Nation • One Health Network • Connected Care
                </div>

            </div>


            <!-- RIGHT LOGO -->

            <div class="logo">

                <img src="~/asset/ehealth2030.png"
                     alt="eHealth Qatar 2030" />

            </div>

        </header>



        <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

        <main class="content">


            <!-- =================================================
             LEFT SIDE
        ================================================== -->

            <section class="left">

                <div class="platform">

                    <img src="~/asset/main2.png"
                         alt="Qatar National Digital Health Mission" />

                </div>

            </section>



            <!-- =================================================
             RIGHT SIDE
        ================================================== -->

            <section class="right"
                     id="rightSection">


                <!-- =================================================
                 PORTAL SELECTION
            ================================================== -->

                <div id="portalSelection"
                     class="portal-selection">


                    <!-- SECTION HEADING -->

                    <div class="section-heading">

                        <span>
                            SELECT YOUR ACCESS PORTAL
                        </span>

                    </div>



                    <!-- =================================================
                     SUPPORT OPERATIONS CENTER
                ================================================== -->

                    <div class="portal-card card-1" 
                         data-title="Support Operations Center"
                         data-icon="fa-headset"
                         data-color="#8A1538">


                        <div class="icon red">

                            <i class="fa-solid fa-headset"></i>

                        </div>


                        <div class="portal-card-body">

                            <div class="portal-title">

                                Support Operations Center

                            </div>


                            <ul class="portal-features">

                                <li>SLA Monitoring</li>

                                <li>National Helpdesk</li>

                                <li>OS Ticket Activities</li>

                                <li>Service Monitoring</li>

                                <li>Ticket Management</li>

                                <li>Escalation Management</li>

                            </ul>


                            <div class="access">

                                Access Portal →

                            </div>

                        </div>


                        <div class="portal-chevron">

                            ›

                        </div>

                    </div>



                    <!-- =================================================
                     HEALTHCARE FACILITY PORTAL
                ================================================== -->

                    <div class="portal-card card-2" style="border-left:5px solid #b38b59"
                         data-title="Healthcare Facility Portal"
                         data-icon="fa-hospital"
                         data-color="#b38b59">


                        <div class="icon gold">

                            <i class="fa-solid fa-hospital"></i>

                        </div>


                        <div class="portal-card-body">

                            <div class="portal-title" style="color:#b38b59;">

                                Healthcare Facility Portal

                            </div>


                            <ul class="portal-features">

                                <li>Hospitals</li>

                                <li>Clinics</li>

                                <li>Laboratories</li>

                                <li>Facility Dashboard</li>

                                <li>Pharmacy Networks</li>

                                <li>System Integrations</li>

                            </ul>


                            <div class="access" style="color:#b38b59;">

                                Access Portal →

                            </div>
                        </div>
                        <div class="portal-chevron" style="color:#b38b59;"> › </div>
                    </div>



                    <!-- =================================================
                     HEALTHCARE PROFESSIONAL PORTAL
                ================================================== -->

                    <div class="portal-card card-3" style="border-left:5px solid #5a9447"
                         data-title="Healthcare Professional Portal"
                         data-icon="fa-user-doctor"
                         data-color="#5a9447">


                        <div class="icon green">

                            <i class="fa-solid fa-user-doctor"></i>

                        </div>


                        <div class="portal-card-body">

                            <div class="portal-title" style="color:#5a9447;">

                                Healthcare Professional Portal

                            </div>


                            <ul class="portal-features">

                                <li>Digital Identity</li>

                                <li>Clinical Access</li>

                                <li>License Verification</li>

                                <li>Professional Services</li>

                                <li>Practitioner Registry</li>

                                <li>Credential Management</li>

                            </ul>


                            <div class="access" style="color:#5a9447;">

                                Access Portal →

                            </div>

                        </div>


                        <div class="portal-chevron" style="color:#5a9447;">

                            ›

                        </div>

                    </div>



                    <!-- =================================================
                     DSC / INTEGRATOR PORTAL
                ================================================== -->

                    <div class="portal-card card-4" style="border-left:5px solid #2367d1"
                         data-title="DSC / Integrator Portal"
                         data-icon="fa-code"
                         data-color="#2367d1">


                        <div class="icon blue">

                            <i class="fa-solid fa-code"></i>

                        </div>


                        <div class="portal-card-body">

                            <div class="portal-title" style="color:#2367d1;">

                                DSC / Integrator Portal

                            </div>


                            <ul class="portal-features">

                                <li>API Gateway</li>

                                <li>Certification Workflow</li>

                                <li>Sandbox Access</li>

                                <li>Production Integrations</li>

                                <li>Developer Resources</li>

                                <li>Compliance Dashboard</li>

                            </ul>


                            <div class="access" style="color:#2367d1;">

                                Access Portal →

                            </div>

                        </div>


                        <div class="portal-chevron" style="color:#2367d1;">

                            ›

                        </div>

                    </div>


                </div>



                <!-- =================================================
                 LOGIN PANEL
            ================================================== -->

                <div id="loginPanel" class="login-panel">
                    <div class="login-card" style="overflow:clip;">
                        <!-- BACK -->
                        <button type="button"
                                class="back-btn"
                                id="backToPortals">

                            <i class="fa-solid fa-arrow-left"></i>

                            <span>
                                Back to Portal Selection
                            </span>

                        </button>

                        <div class="login-content">

                            <!-- PORTAL ICON -->

                            <div class="portal-login-icon" id="loginIcon">

                                <i class="fa-solid fa-headset"></i>

                            </div>



                            <!-- PORTAL TITLE -->

                            <h2 id="loginTitle">

                                Support Operations Center

                            </h2>



                            <!-- SUBTITLE -->

                            <p class="portal-subtitle">

                                Sign in to access your account

                            </p>



                            <!-- =================================================
                             USERNAME
                        ================================================== -->

                            <div class="form-group">

                                <label for="username">

                                    Username

                                </label>


                                <div class="input-wrapper">

                                    <i class="fa-solid fa-user"></i>

                                    <input type="text"
                                           id="username"
                                           name="username"
                                           placeholder="Enter your username"
                                           autocomplete="username" />

                                </div>

                            </div>



                            <!-- =================================================
                             PASSWORD
                        ================================================== -->

                            <div class="form-group">

                                <label for="password">

                                    Password

                                </label>


                                <div class="input-wrapper">

                                    <i class="fa-solid fa-lock"></i>

                                    <input type="password"
                                           id="password"
                                           name="password"
                                           placeholder="Enter your password"
                                           autocomplete="current-password" />

                                </div>

                            </div>



                            <!-- =================================================
                             REMEMBER / FORGOT
                        ================================================== -->

                            <div class="extra">
                                <label class="remember"><input type="checkbox" id="rememberMe" /> <span>Remember Me</span></label>
                                <a href="#" class="forgot"> Forgot Password? </a>
                            </div>

                            <button type="button" class="login-btn" onclick="Login()"> LOGIN </button>

                            <button type="button" class="digital-id"> <i class="fa-solid fa-id-card"></i> Login with Qatar Digital ID </button>

                            <div class="security-box">

                                <i class="fa-solid fa-shield-halved"></i>


                                <span>

                                    All access is monitored and protected
                                    in accordance with Qatar Data Protection
                                    Laws and International Standards.

                                </span>

                            </div>



                            <!-- FOOTER -->

                            <p class="footer-note">

                                © Qatar Ministry of Public Health

                            </p>


                        </div>

                    </div>

                </div>


            </section>

        </main>



        <!-- =====================================================
         FOOTER
    ====================================================== -->

        <footer class="footer">


            <div class="stat">

                <h3>
                    30+
                </h3>

                <p>
                    Hospitals
                </p>

            </div>


            <div class="stat">

                <h3>
                    10,000+
                </h3>

                <p>
                    Healthcare Professionals
                </p>

            </div>


            <div class="stat">

                <h3>
                    Millions
                </h3>

                <p>
                    Secure Health Transactions Daily
                </p>

            </div>


            <div class="stat">

                <h3>
                    100%
                </h3>

                <p>
                    Secure &amp; Compliant
                </p>

            </div>


        </footer>
    </div>
</body>

</html>
