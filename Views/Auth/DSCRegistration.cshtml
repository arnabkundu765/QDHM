@{
    Layout = null;
}
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>DSC / Integrator and HMIS Registration</title>
    <link href="~/css/dsc.css" rel="stylesheet" />
</head>
<body>
    <div class="app">
        <aside class="sidebar"><div class="brand"><div class="logo">QA</div><div><b>Ministry of Public Health</b><small>State of Qatar<br>QNDHM</small></div></div><div class="label">Registration Workspace</div><button class="nav active" id="navRegistration" onclick="showView('registration')">▤ DSC Registration</button><button class="nav" id="navSupport" onclick="showView('support')">◷ Support & Tickets <span class="badge">3</span></button><button class="nav" onclick="location.href='/home/dashboard'">▦ CRM Summary</button><button class="nav" data-admin-only onclick="alert('Role and permission management')">⚙ Role Management</button><div class="rolebox"><label>Demo access role</label><select id="role" onchange="applyRole()"><option value="registrant">Registrant</option><option value="support">Support Agent</option><option value="reviewer">Reviewer</option><option value="admin">Administrator</option></select></div></aside><main class="main">
        <header class="top">
            <div><h1>QATAR NATIONAL DIGITAL HEALTH MISSION (QNDHM)</h1><p>DSC / Integrator and HMIS Registration</p></div>
            <div class="user">
                <div class="avatar">JD</div>
                <div><b>John Doe</b><br /><small>@(ViewBag.Show ? "Integrator Admin" : "Support Operator")</small>
            </div>
        </div>
    </header><div class="page">
    <section id="registrationView" class="view active"><section class="kpis"><div class="kpi"><div class="ki">⌘</div><div><b>175+</b><span>Integrators</span></div></div><div class="kpi"><div class="ki">▦</div><div><b>68</b><span>HMIS Products</span></div></div><div class="kpi"><div class="ki">✓</div><div><b>92%</b><span>Certified</span></div></div><div class="kpi"><div class="ki">◷</div><div><b>18</b><span>Assessments</span></div></div></section><div class="work"><aside class="steps"><div class="progress">Registration Progress<div class="track"><div id="bar" class="bar"></div></div></div><button class="step active" onclick="showStep(0)"><span class="num">1</span>Company Profile</button><button class="step" onclick="showStep(1)"><span class="num">2</span>Contacts & SPOCs</button><button class="step" onclick="showStep(2)"><span class="num">3</span>HMIS / Product Portfolio</button><button class="step" onclick="showStep(3)"><span class="num">4</span>Technical Architecture</button><button class="step" onclick="showStep(4)"><span class="num">5</span>Integration Scope</button><button class="step" onclick="showStep(5)"><span class="num">6</span>Testing & Certification</button><button class="step" onclick="showStep(6)"><span class="num">7</span>Security & Compliance</button><button class="step" onclick="showStep(7)"><span class="num">8</span>Support & Go-Live</button><button class="step" onclick="showStep(8)"><span class="num">9</span>Documents</button><button class="step" onclick="showStep(9)"><span class="num">10</span>Review & Submit</button></aside><section class="content"><div class="head"><div><h2 id="stepTitle">Company Profile</h2><p>Complete the applicable details and continue.</p></div><div style="margin-top: 10px"><span class="chip">Draft</span></div></div><div id="t0" class="tab active"><div class="section"><h3>Company</h3><div class="grid"><div class="" data-role-field=""><label>DSC Registration ID</label><input type="text" value="QNDHM-DSC-2026-00125"></div><div class="" data-role-field=""><label>Legal Name</label><input type="text" value="MediTech Solutions W.L.L."></div><div class="" data-role-field=""><label>Commercial Registration</label><input type="text" value="CRN-1234567890"></div><div class="" data-role-field=""><label>Classification</label><select><option>HMIS Vendor</option><option>EMR Vendor</option><option>LIS Vendor</option><option>Systems Integrator</option></select></div><div class="full" data-role-field=""><label>Qatar Address</label><textarea>West Bay, Doha</textarea></div></div></div></div><div id="t1" class="tab"><div class="section"><h3>Contacts</h3><div class="grid"><div class="" data-role-field=""><label>Primary Contact</label><input type="text" value="Ahmed Al Qahtani"></div><div class="" data-role-field=""><label>Designation</label><input type="text" value="Integration Manager"></div><div class="" data-role-field=""><label>Email</label><input type="email" value="ahmed.qahtani@meditech.qa"></div><div class="" data-role-field=""><label>Mobile</label><input type="text" value="+974 5012 3456"></div></div></div></div><div id="t2" class="tab"><div class="section"><h3>HMIS Product</h3><div class="grid"><div class="" data-role-field=""><label>HMIS Name</label><input type="text" value="MediConnect HMIS"></div><div class="" data-role-field=""><label>Category</label><select><option>HMIS/HIS</option><option>EMR/EHR</option><option>LIS</option><option>RIS/PACS</option><option>Claims</option><option>Patient App</option></select></div><div class="" data-role-field=""><label>Version</label><input type="text" value="v6.2"></div><div class="" data-role-field=""><label>Qatar Deployments</label><input type="number" value="18"></div><div class="" data-role-field=""><label>Global Deployments</label><input type="number" value="120"></div><div class="full" data-role-field=""><label>Description</label><textarea>Enterprise HMIS supporting clinical and administrative workflows.</textarea></div></div></div><div class="section"><h3>Modules</h3><div class="checks"><label class="check"><input type="checkbox"> ADT</label><label class="check"><input type="checkbox"> OPD</label><label class="check"><input type="checkbox"> IPD</label><label class="check"><input type="checkbox"> Emergency</label><label class="check"><input type="checkbox"> CPOE</label><label class="check"><input type="checkbox"> Nursing</label><label class="check"><input type="checkbox"> Laboratory</label><label class="check"><input type="checkbox"> Radiology/PACS</label><label class="check"><input type="checkbox"> Pharmacy</label><label class="check"><input type="checkbox"> Billing</label><label class="check"><input type="checkbox"> Claims</label><label class="check"><input type="checkbox"> Inventory</label><label class="check"><input type="checkbox"> Patient Portal</label><label class="check"><input type="checkbox"> Analytics</label></div></div></div><div id="t3" class="tab"><div class="section"><h3>Architecture</h3><div class="grid three"><div class="" data-role-field=""><label>Deployment</label><select><option>On-Premises</option><option>Private Cloud</option><option>Public Cloud</option><option>Hybrid</option><option>SaaS</option></select></div><div class="" data-role-field=""><label>Cloud Provider</label><select><option>Azure</option><option>AWS</option><option>Google Cloud</option><option>Private Data Centre</option></select></div><div class="" data-role-field=""><label>Architecture</label><select><option>Monolith</option><option>Microservices</option><option>Modular</option><option>Cloud Native</option></select></div><div class="" data-role-field=""><label>Database</label><input type="text" value="PostgreSQL / MS SQL"></div><div class="" data-role-field=""><label>Integration Engine</label><input type="text" value="Mirth Connect"></div><div class="" data-role-field=""><label>API Management</label><input type="text" value="Azure API Management"></div></div></div><div class="section"><h3>Standards</h3><div class="checks"><label class="check"><input type="checkbox"> HL7 v2</label><label class="check"><input type="checkbox"> FHIR R4</label><label class="check"><input type="checkbox"> DICOM</label><label class="check"><input type="checkbox"> ICD-10</label><label class="check"><input type="checkbox"> SNOMED CT</label><label class="check"><input type="checkbox"> LOINC</label><label class="check"><input type="checkbox"> OAuth 2.0</label><label class="check"><input type="checkbox"> OIDC</label></div></div></div><div id="t4" class="tab"><div class="section"><h3>QNDHM Integrations</h3><div class="checks"><label class="check"><input type="checkbox"> Q-HFR</label><label class="check"><input type="checkbox"> Q-HPR</label><label class="check"><input type="checkbox"> Q-HIE</label><label class="check"><input type="checkbox"> Patient Identity</label><label class="check"><input type="checkbox"> Consent Manager</label><label class="check"><input type="checkbox"> ePrescription</label><label class="check"><input type="checkbox"> Claims Exchange</label><label class="check"><input type="checkbox"> Terminology Service</label></div></div></div><div id="t5" class="tab"><div class="section"><h3>Testing</h3><div class="grid"><div class="" data-role-field=""><label>Sandbox Client ID</label><input type="text" value="SBX-MEDITECH-00125"></div><div class="" data-role-field=""><label>Testing Status</label><select><option>Not Started</option><option>In Progress</option><option>Observation Open</option><option>Passed</option></select></div><div class="" data-role-field=""><label>Current Milestone</label><select><option>M1</option><option>M2</option><option>M3</option><option>Certification</option></select></div><div class="" data-role-field=""><label>Pilot Facility</label><input type="text" value="Doha Care Hospital"></div><div class="" data-role-field=""><label>Target Certification</label><input type="date" value=""></div></div></div></div><div id="t6" class="tab"><div class="section"><h3>Security</h3><div class="grid"><div class="" data-role-field=""><label>VAPT Status</label><select><option>Not Started</option><option>In Progress</option><option>Findings Open</option><option>Closed</option></select></div><div class="" data-role-field=""><label>ISO 27001</label><select><option>Certified</option><option>In Progress</option><option>Not Certified</option></select></div><div class="" data-role-field=""><label>Privacy Assessment</label><select><option>Completed</option><option>In Progress</option><option>Not Started</option></select></div><div class="" data-role-field=""><label>Data Residency</label><input type="text" value="Qatar"></div></div></div></div><div id="t7" class="tab"><div class="section"><h3>Operational Support</h3><div class="grid"><div class="" data-role-field=""><label>Support Model</label><select><option>24x7</option><option>Business Hours</option><option>On-call</option></select></div><div class="" data-role-field=""><label>Support Email</label><input type="email" value="support@meditech.qa"></div><div class="" data-role-field=""><label>Ticketing Tool</label><input type="text" value="osTicket / Service Desk"></div><div class="" data-role-field=""><label>Response SLA</label><input type="text" value="30 Minutes"></div><div class="" data-role-field=""><label>Resolution SLA</label><input type="text" value="4 Hours"></div><div class="" data-role-field=""><label>Go-Live Date</label><input type="date" value=""></div></div></div></div><div id="t8" class="tab"><div class="section"><h3>Required Documents</h3>
        <div class="upload">
                    <div class="upload-field">
                        <label for="TradeLicense">Trade License</label>
                        <input type="file" id="TradeLicense" name="TradeLicense"
                               accept=".pdf,.jpg,.jpeg,.png">
                        <a href="#" id="TradeLicenseLink"
                           target="_blank"
                           title="View uploaded Trade License">👁</a>
                    </div>

                    <div class="upload-field">
                        <label for="ProductBrochure">Product Brochure</label>
                        <input type="file" id="ProductBrochure" name="ProductBrochure"
                               accept=".pdf,.jpg,.jpeg,.png">
                        <a href="#" id="ProductBrochureLink"
                           target="_blank"
                           title="View uploaded Product Brochure">👁</a>
                    </div>

                    <div class="upload-field">
                        <label for="Architecture">Architecture</label>
                        <input type="file" id="Architecture" name="Architecture"
                               accept=".pdf,.jpg,.jpeg,.png">
                        <a href="#" id="ArchitectureLink"
                           target="_blank"
                           title="View uploaded Architecture">👁</a>
                    </div>

                    <div class="upload-field">
                        <label for="APICatalogue">API Catalogue</label>
                        <input type="file" id="APICatalogue" name="APICatalogue"
                               accept=".pdf,.jpg,.jpeg,.png">
                        <a href="#" id="APICatalogueLink"
                           target="_blank"
                           title="View uploaded API Catalogue">👁</a>
                    </div>
                    <div class="upload-field">
                        <label for="DataFlow">Data Flow</label>
                        <input type="file" id="DataFlow" name="DataFlow"
                               accept=".pdf,.jpg,.jpeg,.png">
                        <a href="#" id="DataFlowLink"
                           target="_blank"
                           title="View uploaded Data Flow">👁</a>
                    </div>

                    <div class="upload-field">
                        <label for="VAPT">VAPT</label>
                        <input type="file" id="VAPT" name="VAPT"
                               accept=".pdf,.jpg,.jpeg,.png">
                        <a href="#" id="VAPTLink"
                           target="_blank"
                           title="View uploaded VAPT">👁</a>
                    </div>

                    <div class="upload-field">
                        <label for="PrivacyAssessment">Privacy Assessment</label>
                        <input type="file" id="PrivacyAssessment" name="PrivacyAssessment"
                               accept=".pdf,.jpg,.jpeg,.png">
                        <a href="#" id="PrivacyAssessmentLink"
                           target="_blank"
                           title="View uploaded Privacy Assessment ">👁</a>
                    </div>
                    <div class="upload-field">
                        <label for="SupportSLA">Support SLA</label>
                        <input type="file" id="SupportSLA" name="SupportSLA"
                               accept=".pdf,.jpg,.jpeg,.png">
                        <a href="#" id="SupportSLALink"
                           target="_blank"
                           title="View uploaded Support SLA">👁</a>
                    </div>
        </div>
        </div></div><div id="t9" class="tab"><div class="section"><h3>Review</h3>DSC and HMIS registration is ready for review and submission.</div></div></section></div></section><section id="supportView" class="view">
    <div class="notice">Create a new support ticket and track its complete status, assignment, SLA and activity timeline.</div><div class="ticket-tabs"><button id="ttTrack" class="ticket-tab active" onclick="showTicketSection('track')">Track Tickets</button><button id="ttNew" class="ticket-tab" onclick="showTicketSection('new')">Generate New Ticket</button></div><div id="ticketTrackSection" class="support-grid"><div><div class="panel"><div class="panel-head"><div><h2>Support & Ticket Management</h2><small id="supportScope">All tickets visible for current role</small></div><button class="btn primary" onclick="newTicket()">+ Create Ticket</button></div><div class="filters"><input id="ticketSearch" placeholder="Search ticket ID, subject or registration ID" oninput="filterTickets()"><select id="ticketStatus" onchange="filterTickets()"><option value="">All Statuses</option><option>Open</option><option>In Progress</option><option>Awaiting User</option><option>Resolved</option><option>Closed</option></select><select id="ticketPriority" onchange="filterTickets()"><option value="">All Priorities</option><option>Low</option><option>Medium</option><option>High</option><option>Critical</option></select><select id="ticketCategory" onchange="filterTickets()"><option value="">All Categories</option><option>Registration</option><option>Documents</option><option>Integration</option><option>Compliance</option><option>Security</option><option>Production</option></select><button class="btn light" onclick="resetTickets()">Reset</button></div><div class="tablewrap"><table><thead><tr><th>Ticket ID</th><th>Registration ID</th><th>Subject</th><th>Category</th><th>Priority</th><th>Status</th><th>Assigned To</th><th>SLA</th><th>Action</th></tr></thead><tbody id="ticketRows"></tbody></table></div></div></div><aside style="display:none;"><div class="section"><h3>Add / Update Ticket</h3><div class="grid"><div><label>Registration ID</label><input id="fReg" value="REG-2026-00125"></div><div><label>Ticket ID</label><input id="fTicket" value="QNDHM-TKT-2026-0112"></div><div class="full"><label>Subject</label><input id="fSubject" value="Sandbox authentication support"></div><div><label>Category</label><select id="fCategory"><option>Registration</option><option>Documents</option><option>Integration</option><option>Compliance</option><option>Security</option><option>Production</option></select></div><div><label>Priority</label><select id="fPriority"><option>Low</option><option>Medium</option><option selected>High</option><option>Critical</option></select></div><div data-role-field="agent"><label>Status</label><select id="fStatus"><option>Open</option><option>In Progress</option><option>Awaiting User</option><option>Resolved</option><option>Closed</option></select></div><div data-role-field="agent"><label>Assigned Agent</label><input id="fAgent" value="Integration Support"></div><div class="full"><label>Interaction Summary</label><textarea id="fSummary">Describe issue, response, action item and next step.</textarea></div></div><div class="support-actions"><button class="btn primary" onclick="saveTicket()">Save Ticket</button></div></div><div class="section"><h3>Role Permissions</h3><div id="permissions"></div></div></aside> </div>
<div id="ticketNewSection" class="section hidden" style="margin:18px"><h3>Generate New Support Ticket</h3><div class="grid three"><div><label>Registration Type</label><select id="nType"><option>Healthcare Facility</option><option>Healthcare Professional</option><option>DSC / Integrator</option></select></div><div><label>Registration ID *</label><input id="nReg" placeholder="Enter registration ID"></div><div><label>Auto-Generated Ticket ID</label><input id="nTicket" readonly></div><div class="full"><label>Ticket Subject *</label><input id="nSubject" placeholder="Enter a clear issue title"></div><div><label>Issue Category *</label><select id="nCategory"><option>Registration</option><option>Profile Update</option><option>Document Verification</option><option>Sandbox / API</option><option>Integration</option><option>Compliance</option><option>Security</option><option>Production</option></select></div><div><label>Priority</label><select id="nPriority"><option>Low</option><option selected>Medium</option><option>High</option><option>Critical</option></select></div><div><label>Raised By</label><input id="nRaisedBy" value="Current Portal User"></div><div><label>Contact Email</label><input id="nEmail" type="email" placeholder="name@organization.qa"></div><div><label>Contact Mobile</label><input id="nMobile" placeholder="+974"></div><div class="full"><label>Issue Description *</label><textarea id="nDescription" placeholder="Describe the issue, steps performed, error message and expected result"></textarea></div><div class="full"><label>Attachment / Log Reference</label><input id="nAttachment" placeholder="Screenshot, log, document or secure file reference"></div></div><div class="support-actions"><button class="btn light" onclick="clearNewTicket()">Clear</button><button class="btn primary" onclick="generateTicket()">Generate Ticket</button></div></div>
<div id="ticketTimelineSection" class="section hidden" style="margin:18px"><div class="panel-head" style="padding:0 0 14px;border:0"><div><h2 id="timelineTitle">Ticket Tracking</h2><small id="timelineSub"></small></div><button class="btn light" onclick="showTicketSection('track')">Back to Tickets</button></div><div class="grid three"><div><label>Current Status</label><input id="trackStatus" readonly></div><div><label>Assigned Team</label><input id="trackAgent" readonly></div><div><label>SLA</label><input id="trackSla" readonly></div></div><div class="timeline-box" id="timelineBox"></div><div class="section"><h3>Add Comment</h3><textarea id="trackComment" placeholder="Add update, response or additional information"></textarea><div class="support-actions"><button class="btn primary" onclick="addTrackingComment()">Add Comment</button></div></div></div>
</section></div></main></div><div id="formFooter" class="footer"><small id="saved">Draft not saved</small><div><button class="btn outline" onclick="saveDraft()">Save Draft</button><button class="btn light" onclick="move(-1)">Previous</button><button class="btn primary" onclick="move(1)">Save & Continue</button></div></div>
<script src="~/js/dsc.js"></script>
</body>
</html>