"><h3>Modules</h3><div class="checks"><label class="check"><input type="checkbox"> ADT</label><label class="check"><input type="checkbox"> OPD</label><label class="check"><input type="checkbox"> IPD</label><label class="check"><input type="checkbox"> Emergency</label><label class="check"><input type="checkbox"> CPOE</label><label class="check"><input type="checkbox"> Nursing</label><label class="check"><input type="checkbox"> Laboratory</label><label class="check"><input type="checkbox"> Radiology/PACS</label><label class="check"><input type="checkbox"> Pharmacy</label><label class="check"><input type="checkbox"> Billing</label><label class="check"><input type="checkbox"> Claims</label><label class="check"><input type="checkbox"> Inventory</label><label class="check"><input type="checkbox"> Patient Portal</label><label class="check"><input type="checkbox"> Analytics</label></div></div></div><div id="t3" class="tab"><div class="section"><h3>Architecture</h3><div class="grid three"><div class="" data-role-field=""><label>Deployment</label><select><option>On-Premises</option><option>Private Cloud</option><option>Public Cloud</option><option>Hybrid</option><option>SaaS</option></select></div><div class="" data-role-field=""><label>Cloud Provider</label><select><option>Azure</option><option>AWS</option><option>Google Cloud</option><option>Private Data Centre</option></select></div><div class="" data-role-field=""><label>Architecture</label><select><option>Monolith</option><option>Microservices</option><option>Modular</option><option>Cloud Native</option></select></div><div class="" data-role-field=""><label>Database</label><input type="text" value="PostgreSQL / MS SQL"></div><div class="" data-role-field=""><label>Integration Engine</label><input type="text" value="Mirth Connect"></div><div class="" data-role-field=""><label>API Management</label><input type="text" value="Azure API Management"></div></div></div><div class="section"><h3>Standards</h3><div class="checks"><