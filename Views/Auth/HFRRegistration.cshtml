                <label for="securityDocuments">Security Documents</label>
                <input type="file" id="securityDocuments" name="securityDocuments" accept=".pdf,.jpg,.jpeg,.png">
    </div> *@
            <div class="upload">

                    <div class="upload-field">
                        <label for="tradeLicense">Trade License</label>
