            <div class="section"><div class="grid"><div class="field"><label>Sandbox Access Date</label><input type="date" value="2026-10-20"></div><div class="field"><label>Compliance Assessment Date</label><input type="date" value="2026-11-05"></div><div class="field"><label>Pilot Launch Date</label><input type="date"></div><div class="field"><label>Production Go-Live Date</label><input type="date"></div><div class="field"><label>Onboarding Session Planned On</label><input type="date"></div><div class="field"><label>Q/A Session Preference</label><input type="datetime-local"></div></div></div>
        </div>

        <div id="compliance" class="tab">
            <div class="section"><div class="section-title"><h3>Functional testing &amp; compliance</h3><span>Assessment partner information</span></div><div class="grid three"><div class="field"><label>Compliance Partner</label><input value="Approved Assessment Partner"></div><div class="field"><label>Assessment Start Date</label><input type="date" value="2026-11-05"></div><div class="field"><label>Assessment End Date</label><input type="date" value="2026-11-20"></div><div class="field"><label>Milestone</label><select><option>Milestone 2</option><option>Milestone 1</option><option>Milestone 3</option></select></div><div class="field"><label>Risk Rating</label><select><option>Low</option><option>Medium</option><option>High</option></select></div><div class="field"><label>Compliance Status</label><select><option>Observation Open</option><option>Passed</option><option>Re-test Required</option><option>Certified</option></select></div><div class="field full"><label>Findings Summary</label><textarea>Minor observations related to API error handling and data validation.</textarea></div></div></div>
        </div>

        <div id="security" class="tab">
