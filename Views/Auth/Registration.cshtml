<div class="footer-actions"><small id="saveStatus">Last saved locally: not yet saved</small><div class="footer-buttons"><button class="btn btn-outline" onclick="saveDraft()">Save as Draft</button><button id="prevBtn" class="btn btn-light" onclick="move(-1)" disabled>Previous</button><button id="nextBtn" class="btn btn-primary" onclick="move(1)">Save &amp; Continue</button></div></div>
<div id="toast" class="toast">Draft saved</div>
<script>
        const steps = [
            ['profile', 'Profile Details', 'Create the primary QNDHM portal profile.'],
            ['organization', 'Organization Details', 'Provide legal and registered organization information.'],
            ['contacts', 'Contacts & SPOCs', 'Manage primary, functional, technical and compliance contacts.'],
            ['product', 'Product & Integration', 'Describe the product and select requested QNDHM integrations.'],
            ['onboarding', 'Onboarding Timeline', 'Plan the journey from registration to production go-live.'],
            ['compliance', 'Compliance Assessment', 'Track functional testing, observations and certification.'],
            ['security', 'Security Assessment', 'Record VAPT details, findings and closure status.'],
            ['support', 'Support & Tickets', 'Maintain communication logs and QNDHM support ticket history.'],
            ['review', 'Review & Submit', 'Review the complete application before submission.']
        ];
        let current = 0;
        const buttons = [...document.querySelectorAll('.step-btn')];
        function showStep(index) {
            current = Math.max(0, Math.min(index, steps.length - 1));
            document.querySelectorAll('.tab').forEach(x => x.classList.remove('active'));
            document.getElementById(steps[current][0]).classList.add('active');
            buttons.forEach((b, i) => { b.classList.toggle('active', i === current); b.classList.toggle('done', i < current); if (i < current) b.querySelector('.step-num').textContent = '✓'; else b.querySelector('.step-num').textContent = i + 1; });
            document.getElementById('pageTitle').textContent = steps[current][1];
            document.getElementById('pageSub').textContent = steps[current][2];
            document.getElementById('progressBar').style.width = ((current + 1) / steps.length * 100) + '%';
            document.getElementById('prevBtn').disabled = current === 0;
            document.getElementById('nextBtn').textContent = current === steps.length - 1 ? 'Submit for Review' : 'Save & Continue';
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
        buttons.forEach((b, i) => b.addEventListener('click', () => showStep(i)));
        function move(dir) {
            if (current === steps.length - 1 && dir === 1) {
                if (!document.getElementById('declaration').checked) { toast('Please accept the declaration before submission'); return; }
                toast('Application submitted for QNDHM review'); return;
            }
            saveDraft(false); showStep(current + dir);
        }
        function saveDraft(show = true) {
            const now = new Date().toLocaleString(); localStorage.setItem('qndhmDraftSaved', now); document.getElementById('saveStatus').textContent = 'Last saved locally: ' + now; if (show) toast('Draft saved successfully');
        }
        function toast(msg) { const t = document.getElementById('toast'); t.textContent = msg; t.classList.add('show'); setTimeout(() => t.classList.remove('show'), 2200) }
        function addContact() {
            const role = document.getElementById('contactRole').value, name = document.getElementById('contactName').value.trim(), des = document.getElementById('contactDesignation').value.trim(), email = document.getElementById('contactEmail').value.trim(), mobile = document.getElementById('contactMobile').value.trim();
            if (!name || !email || !mobile) { toast('Enter name, email and mobile number'); return; }
            const tr = document.createElement('tr'); tr.innerHTML = `<td>${role}</td><td>${name}</td><td>${des || '-'}</td><td>${email}</td><td>+974 ${mobile}</td><td>✎ &nbsp; 🗑</td>`; document.getElementById('contactRows').appendChild(tr); toast('Contact added');
        }
        showStep(0);
</script>
</body>
